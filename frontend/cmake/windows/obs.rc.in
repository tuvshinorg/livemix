IDI_ICON1 ICON DISCARDABLE "cmake/windows/obs-studio.ico"

1 VERSIONINFO
FILEVERSION ${LIVEMIX_VERSION_MAJOR},${LIVEMIX_VERSION_MINOR},${LIVEMIX_VERSION_PATCH},0
PRODUCTVERSION ${LIVEMIX_VERSION_MAJOR},${LIVEMIX_VERSION_MINOR},${LIVEMIX_VERSION_PATCH},0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "LiveMix"
      VALUE "FileDescription", "LiveMix"
      VALUE "FileVersion", "${LIVEMIX_VERSION}"
      VALUE "InternalName", "obs"
      VALUE "OriginalFilename", "obs64.exe"
      VALUE "ProductName", "LiveMix"
      VALUE "ProductVersion", "${LIVEMIX_VERSION}"
      VALUE "Comments", "Live production switcher built on OBS Studio ${OBS_VERSION_CANONICAL}"
      VALUE "LegalCopyright", "${OBS_LEGAL_COPYRIGHT}"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
