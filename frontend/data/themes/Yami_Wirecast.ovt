/* ------------------------------------------------------------------------- *
 *                                                                           *
 * Variant Theme (Style) for Yami named LiveMix ("Tally").                   *
 *                                                                           *
 * Calm, warm-grey panels for long shows. Bright colour only ever means     *
 * on-air state, like a camera's tally light: green = Preview, red = Live.   *
 * The primary action (Go) is ivory; selection is a lighter neutral.        *
 *                                                                           *
 * The theme id is kept from the earlier Wirecast variant so existing        *
 * settings keep selecting it.                                               *
 *                                                                           *
 * ------------------------------------------------------------------------- */

@OBSThemeMeta {
    name: 'LiveMix';
    id: 'com.obsproject.Yami.Wirecast';
    extends: 'com.obsproject.Yami';
    author: 'odmundurmedia';
    dark: 'true';
}

@OBSThemeVars {
    /* Neutrals, light to dark */
    --grey1: #75726B;
    --grey2: #5A5852;
    --grey3: #3A3C42;
    --grey4: #2E3035;
    --grey5: #2A2C31;
    --grey6: #232529;
    --grey7: #1B1C1F;
    --grey8: #131416;

    /* Surfaces */
    --lm_ground: #131416;
    --lm_inset: #17181A;
    --lm_panel: #1B1C1F;
    --lm_menu: #1E1F22;
    --lm_control: #232529;
    --lm_control_hover: #2A2C31;
    --lm_selected: #2E3035;
    --lm_field: #141517;
    --lm_line: #2C2E33;
    --lm_line_soft: #232529;
    --lm_line_strong: #3A3C42;

    /* Text */
    --lm_text: #D8D5CE;
    --lm_text_strong: #E9E6DF;
    --lm_text_soft: #A9A69E;
    --lm_text_muted: #8E8B84;
    --lm_text_faint: #75726B;

    /* Primary action */
    --lm_ivory: #E4E1D9;
    --lm_ivory_hover: #F3F1EC;
    --lm_ivory_down: #CFCBC2;
    --lm_on_ivory: #17181A;

    /* On-air state */
    --lm_green: #4CC38A;
    --lm_green_text: #7FD3A8;
    --lm_red: #E5533D;
    --lm_red_fill: #C2412E;
    --lm_red_tint: #3B1E19;
    --lm_red_tint_hover: #4A241D;
    --lm_red_text: #F6B3A5;

    --bg_window: var(--lm_ground);
    --bg_base: var(--lm_panel);
    --bg_preview: var(--lm_panel);

    --primary: var(--grey3);
    --primary_light: #45474D;
    --primary_lighter: #55575D;
    --primary_dark: var(--grey4);
    --primary_darker: var(--grey6);

    --text: var(--lm_text);
    --text_light: var(--lm_text_strong);
    --text_muted: var(--lm_text_muted);

    --border_color: var(--lm_line);
    --border_radius: 6px;
    --border_radius_small: 4px;
    --border_radius_large: 10px;

    --input_bg: var(--lm_field);
    --input_bg_hover: var(--lm_inset);
    --input_bg_focus: var(--lm_field);
    --input_border: var(--lm_line);
    --input_border_hover: var(--lm_line_strong);
    --input_border_focus: var(--lm_text_muted);

    --button_bg: var(--lm_control);
    --button_bg_hover: var(--lm_control_hover);
    --button_bg_down: #1E1F22;
    --button_bg_disabled: #1F2023;
    --button_border: var(--lm_line);
    --button_border_hover: var(--lm_line_strong);
    --button_border_focus: var(--lm_text_muted);

    --list_item_bg_selected: var(--lm_selected);
    --list_item_bg_hover: var(--lm_control);

    --scrollbar_handle: #34363C;
    --scrollbar_bg: var(--lm_panel);
    --scrollbar_hover: #45474D;
    --scrollbar_down: #55575D;
    --scrollbar_border: var(--lm_panel);

    --palette_link: var(--lm_text_strong);
    --palette_linkVisited: var(--lm_text_soft);
}

/* ------------------------------------------------------------------ */
/* Type: Onest (bundled), with Open Sans as the fallback               */

QWidget {
    font-family: 'Onest', 'Open Sans', '.AppleSystemUIFont', Helvetica, Arial, 'MS Shell Dlg', sans-serif;
}

/* ------------------------------------------------------------------ */
/* Window chrome                                                       */

QMainWindow {
    background: var(--lm_ground);
}

QMenuBar {
    background: var(--lm_ground);
    color: var(--lm_text_soft);
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 9px;
    border-radius: 6px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background: var(--lm_control);
    color: var(--lm_text_strong);
}

QMenu {
    background: var(--lm_menu);
    border: 1px solid var(--lm_line);
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: var(--lm_selected);
    color: var(--lm_text_strong);
}

QMenu::item:disabled {
    color: var(--lm_text_faint);
}

QMenu::separator {
    height: 1px;
    background: var(--lm_line);
    margin: 4px 8px;
}

/* The gaps between docks show the ground colour, so each dock reads as a panel */
QMainWindow::separator {
    background: var(--lm_ground);
    width: 6px;
    height: 6px;
}

QMainWindow::separator:hover {
    background: var(--lm_line_strong);
}

QToolTip {
    background: var(--lm_menu);
    color: var(--lm_text);
    border: 1px solid var(--lm_line);
    border-radius: 6px;
    padding: 4px 8px;
}

/* ------------------------------------------------------------------ */
/* Docks                                                                */

QDockWidget {
    font-size: var(--font_small);
    font-weight: normal;
    color: var(--lm_text);
}

QDockWidget::title {
    background-color: var(--lm_panel);
    border: none;
    border-bottom: 1px solid var(--lm_line_soft);
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    padding: var(--padding_base) var(--padding_xlarge);
}

OBSDock > QWidget {
    background: var(--lm_panel);
    border: none;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

OBSDock QToolBar {
    background: var(--lm_panel);
    border-top: 1px solid var(--lm_line_soft);
}

OBSDock QToolBar QToolButton:hover {
    border-color: var(--lm_line_strong);
    background: var(--lm_control_hover);
}

QAbstractScrollArea {
    border-radius: 0px;
}

/* ------------------------------------------------------------------ */
/* Monitors: green Preview outline, red Live outline                    */

#centralwidget {
    background: var(--lm_panel);
}

#canvasEditor {
    background: var(--lm_panel);
}

OBSQTDisplay {
    qproperty-displayBackgroundColor: var(--lm_panel);
}

.label-preview-title {
    font-size: var(--font_base);
    font-weight: 600;
    color: var(--lm_text_strong);
    background: transparent;
    padding: 2px 0px;
    margin-bottom: 4px;
    border-bottom: 2px solid var(--lm_green);
}

#programLabel {
    border-bottom: 2px solid var(--lm_red);
}

/* ------------------------------------------------------------------ */
/* Scenes list in grid mode                                            */

.list-grid SceneTree::item {
    color: var(--lm_text_strong);
    background-color: var(--lm_field);
    border: 2px solid transparent;
    border-radius: 6px;
    margin: 3px;
}

.list-grid SceneTree::item:hover {
    border-color: var(--lm_line_strong);
}

.list-grid SceneTree::item:selected,
.list-grid SceneTree::item:selected:hover {
    background-color: var(--lm_field);
    border-color: var(--lm_text_muted);
}

QListWidget::item:selected {
    background-color: var(--lm_selected);
    color: var(--lm_text_strong);
}

/* ------------------------------------------------------------------ */
/* Shots: layer rows of shot tiles                                      */

LayersPanel,
LayersPanel #layersContent {
    background: var(--lm_panel);
}

.layer-row {
    background: var(--lm_panel);
    border: none;
}

/* The line under each layer; drag it to resize the layer */
#layerDivider {
    background: var(--lm_panel);
    border: none;
    border-bottom: 1px solid var(--lm_line_soft);
}

#layerDivider:hover {
    border-bottom: 1px solid var(--lm_text_faint);
}

.layer-row #layerHeader {
    background: transparent;
    color: var(--lm_text_muted);
    font-size: var(--font_small);
    font-weight: 500;
    padding: 10px 0px 0px 14px;
    border: none;
}

/* Layer picked with Go to Layer (or the last shot clicked) */
.layer-row.layer-current #layerHeader {
    color: var(--lm_text_strong);
}

/* Switch > Layer Visibility: hidden layer */
.layer-row.layer-hidden #layerHeader {
    color: #4A4C52;
}

.layer-row.drop-target {
    background: var(--lm_control);
}

/* Tiles paint their own thumbnail outline (idle, Preview, Live); every state
 * is listed so Yami's borders and red name bar do not show through */
.shot-tile,
.shot-tile:hover,
.shot-tile.shot-active,
.shot-tile.shot-live {
    background: transparent;
    border: none;
}

.shot-tile #shotThumbnail,
.shot-tile.shot-clear #shotThumbnail {
    background: transparent;
    border: none;
}

.shot-tile #shotName {
    background: transparent;
    color: var(--lm_text_soft);
    font-size: var(--font_small);
    padding: 0px 2px;
}

.shot-tile.shot-active #shotName,
.shot-tile.shot-live #shotName {
    background: transparent;
    color: var(--lm_text_strong);
}

.shot-tile #shotState {
    background: transparent;
    font-size: var(--font_small);
    font-weight: 500;
    padding: 0px 2px;
}

.shot-tile.shot-active #shotState {
    color: var(--lm_green_text);
}

.shot-tile.shot-live #shotState {
    color: #F08A78;
}

/* Shots on a hidden layer turn grey */
.shot-tile.shot-hidden #shotName,
.shot-tile.shot-hidden #shotState {
    color: var(--lm_text_faint);
}

/* Number key from Keyboard Shortcut, drawn on the shot icon */
.shot-tile #shotHotkey {
    background: rgba(19, 20, 22, 0.85);
    color: var(--lm_text_strong);
    font-size: var(--font_small);
    font-weight: 600;
    border: none;
    border-radius: 4px;
    padding: 0px 4px;
}

/* "Add shot" at the end of each layer row */
.wc-add-shot {
    background: transparent;
    border: 1px dashed #3A3C42;
    border-radius: 6px;
    color: var(--lm_text_muted);
    font-size: var(--font_small);
    padding: 0px;
    margin: 0px;
}

.wc-add-shot:hover {
    background: var(--lm_control);
    border-color: var(--lm_text_faint);
    color: var(--lm_text);
}

/* ------------------------------------------------------------------ */
/* Buttons                                                              */

QPushButton {
    border-radius: 6px;
}

QPushButton:checked {
    background-color: var(--lm_selected);
    border-color: #6B6964;
    color: var(--lm_text_strong);
}

QPushButton:default {
    background: var(--lm_ivory);
    border-color: var(--lm_ivory);
    color: var(--lm_on_ivory);
    font-weight: 600;
}

QPushButton:default:hover {
    background: var(--lm_ivory_hover);
    border-color: var(--lm_ivory_hover);
}

/* Studio Mode transition button: the ivory primary action */
#transitionButton {
    background: var(--lm_ivory);
    border-color: var(--lm_ivory);
    color: var(--lm_on_ivory);
}

#transitionButton:hover {
    background: var(--lm_ivory_hover);
    border-color: var(--lm_ivory_hover);
}

#transitionButton:pressed {
    background: var(--lm_ivory_down);
}

/* ------------------------------------------------------------------ */
/* Broadcast controls: on-air states go red                            */

#controlsFrame {
    background: var(--lm_panel);
}

#streamButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active,
#pauseRecordButton:!hover:!pressed.state-active,
#broadcastButton:!hover:!pressed.state-active {
    background: var(--lm_red_tint);
    border-color: var(--lm_red_fill);
    color: var(--lm_red_text);
}

#streamButton:hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active,
#pauseRecordButton:hover:!pressed.state-active,
#broadcastButton:hover:!pressed.state-active {
    background: var(--lm_red_tint_hover);
    border-color: var(--lm_red);
    color: var(--lm_red_text);
}

#replayBufferButton:!pressed.state-active,
#virtualCamButton:!pressed.state-active {
    background: var(--lm_selected);
    color: var(--lm_text_strong);
}

#modeSwitch:!hover:!pressed.state-active {
    background: var(--lm_selected);
    color: var(--lm_text_strong);
}

#modeSwitch:hover:!pressed.state-active {
    background: var(--lm_control_hover);
    color: var(--lm_text_strong);
}

/* ------------------------------------------------------------------ */
/* Transitions T-bar                                                    */

#transitionsFrame {
    background: var(--lm_panel);
}

.slider-tbar::groove:horizontal {
    background: var(--lm_field);
    border: 1px solid var(--lm_line);
}

.slider-tbar::sub-page:horizontal {
    background: var(--lm_ivory);
}

.slider-tbar::handle:horizontal {
    background: var(--lm_text_strong);
    border: 1px solid var(--lm_ground);
    border-radius: 2px;
}

/* ------------------------------------------------------------------ */
/* Audio meters & sliders                                               */

QSlider::sub-page:horizontal {
    background: var(--lm_text_soft);
}

QSlider::handle {
    background: var(--lm_ivory);
}

VolumeMeter {
    qproperty-backgroundNominalColor: #1C2A22;
    qproperty-backgroundWarningColor: #2E2716;
    qproperty-backgroundErrorColor: #33201B;
    qproperty-foregroundNominalColor: #6FB585;
    qproperty-foregroundWarningColor: #D9A441;
    qproperty-foregroundErrorColor: #E5533D;
}

/* ------------------------------------------------------------------ */
/* Status bar & tabs                                                    */

OBSBasicStatusBar {
    background: var(--lm_ground);
    border-top: none;
    color: var(--lm_text_muted);
}

OBSBasicStatusBar QLabel {
    color: var(--lm_text_muted);
}

QTabBar::tab:selected {
    background: var(--lm_selected);
    border-color: var(--lm_selected);
    color: var(--lm_text_strong);
}

/* ------------------------------------------------------------------ */
/* Output bar above the monitors                                        */

#wirecastBroadcastBar {
    background: var(--lm_panel);
    border-bottom: 1px solid var(--lm_line_soft);
    min-height: 44px;
}

/* Stream / Record / Replay: one pill each with its clock */
.wc-output-button {
    background: var(--lm_control);
    border: none;
    border-radius: 8px;
    color: var(--lm_text);
    font-weight: 500;
    padding: 0px 14px 0px 10px;
    margin: 0px;
}

.wc-output-button:hover {
    background: var(--lm_control_hover);
}

.wc-output-button.wc-output-active {
    background: var(--lm_red_tint);
    color: var(--lm_red_text);
}

.wc-output-button.wc-output-active:hover {
    background: var(--lm_red_tint_hover);
}

.wc-toolbar-button {
    background: var(--lm_control);
    border: none;
    border-radius: 8px;
    padding: 0px;
    margin: 0px;
}

.wc-toolbar-button:hover {
    background: var(--lm_control_hover);
}

#wirecastLayoutGroup {
    background: var(--lm_inset);
    border-radius: 9px;
}

.wc-layout-button {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0px;
    margin: 0px;
}

.wc-layout-button:hover {
    background: var(--lm_control);
}

.wc-layout-button:checked {
    background: var(--lm_control_hover);
}

/* ------------------------------------------------------------------ */
/* Sidebar: vertical icon rail, heading, shot name                      */

#wirecastSidebar,
#wirecastSidebarPages {
    background: var(--lm_panel);
}

#wirecastSidebarRail {
    background: var(--lm_inset);
}

.wc-sidebar-tab {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0px;
    margin: 0px;
}

.wc-sidebar-tab:hover {
    background: var(--lm_control);
}

.wc-sidebar-tab:checked {
    background: var(--lm_control_hover);
}

.wc-sidebar-collapse {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0px;
    margin: 0px;
}

.wc-sidebar-collapse:hover {
    background: var(--lm_control);
}

#wirecastSidebarHeading {
    color: var(--lm_text_strong);
    font-size: 11pt;
    font-weight: 600;
    padding: 16px 16px 12px 16px;
    background: transparent;
}

#wirecastShotNameRow QLabel {
    font-size: var(--font_small);
    color: var(--lm_text_muted);
}

#wirecastShotName {
    background: var(--lm_field);
    border: 1px solid var(--lm_line);
    border-radius: 6px;
    padding: 3px 8px;
    font-size: var(--font_base);
    color: var(--lm_text_strong);
}

#wirecastShotName:focus {
    border-color: var(--lm_text_muted);
}

/* ------------------------------------------------------------------ */
/* Documents window (File > Documents)                                  */

#lmDocuments {
    background: var(--lm_panel);
}

#lmDocumentsHeader {
    background: var(--lm_panel);
    border-bottom: 1px solid var(--lm_line_soft);
}

#lmDocumentsTitle {
    color: var(--lm_text_strong);
    font-size: 12pt;
    font-weight: 600;
    background: transparent;
}

#lmDocumentsSide {
    background: var(--lm_inset);
}

#lmDocumentsBody,
#lmDocumentsBodyContent {
    background: var(--lm_panel);
    border: none;
}

#lmDocumentsSection {
    color: var(--lm_text_strong);
    font-size: 11pt;
    font-weight: 600;
    background: transparent;
}

#lmDocumentsHint {
    color: var(--lm_text_muted);
    font-size: var(--font_small);
    background: transparent;
}

.lm-primary-button {
    background: var(--lm_ivory);
    border: none;
    border-radius: 8px;
    color: var(--lm_on_ivory);
    font-weight: 600;
    padding: 0px 16px;
}

.lm-primary-button:hover {
    background: var(--lm_ivory_hover);
}

.lm-primary-button:pressed {
    background: var(--lm_ivory_down);
}

.lm-primary-button:disabled {
    background: var(--lm_control);
    color: var(--lm_text_faint);
}

.lm-secondary-button {
    background: var(--lm_control);
    border: none;
    border-radius: 8px;
    color: var(--lm_text);
    font-weight: 500;
    padding: 0px 16px;
}

.lm-secondary-button:hover {
    background: var(--lm_control_hover);
}

.lm-doc-card {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 11px;
}

.lm-doc-card:hover {
    border-color: var(--lm_line_strong);
}

.lm-doc-card.lm-doc-selected {
    border-color: var(--lm_text_soft);
}

#lmDocCardName {
    color: var(--lm_text_strong);
    font-weight: 600;
    background: transparent;
}

#lmDocCardDetail {
    color: var(--lm_text_muted);
    font-size: var(--font_small);
    background: transparent;
}

.lm-doc-more {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0px;
}

.lm-doc-more:hover {
    background: var(--lm_control_hover);
}

#lmDocumentsFooter {
    background: var(--lm_panel);
    border-top: 1px solid var(--lm_line_soft);
}

/* ------------------------------------------------------------------ */
/* Shot Editor pages                                                    */

#wcEditorPage,
#wcEditorContent,
#wcShotLayersPage,
#wcShotLayerList,
#wcShotLayerListContent,
#wcSourcePropertiesPage {
    background: var(--lm_panel);
    border: none;
}

/* + - and up/down button pairs under the shot name */
.wc-tool-group {
    background: transparent;
    border: 1px solid var(--lm_line);
    border-radius: 6px;
}

.wc-editor-tool {
    background: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
}

.wc-editor-tool.wc-tool-divided {
    border-right: 1px solid var(--lm_line);
}

.wc-editor-tool:hover {
    background: var(--lm_control_hover);
}

.wc-editor-tool:disabled {
    background: transparent;
}

.wc-editor-tool::menu-indicator {
    image: none;
}

/* One source layer of the shot */
#shotLayerRow {
    background: transparent;
    border: none;
    border-radius: 6px;
}

#shotLayerRow:hover {
    background: var(--lm_control);
}

#shotLayerRow.selected {
    background: var(--lm_control_hover);
}

#shotLayerName {
    color: var(--lm_text);
    font-size: var(--font_base);
    background: transparent;
}

.wc-layer-toggle {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 2px;
    margin: 0px;
}

.wc-layer-toggle:hover {
    background: var(--lm_selected);
}

.wc-layer-toggle:checked {
    background: transparent;
}

.wc-layer-toggle:checked:hover {
    background: var(--lm_selected);
}

.wc-editor-label {
    color: var(--lm_text_muted);
    font-size: var(--font_small);
}

.wc-editor-empty {
    color: var(--lm_text_muted);
    font-size: var(--font_small);
}

.wc-editor-subtitle {
    color: var(--lm_text_strong);
    font-weight: 500;
}

/* Collapsible Crop / Color / Build In panes */
.wc-editor-section {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--lm_line_soft);
    border-radius: 0px;
    padding: 6px 0px;
    margin: 4px 0px 0px 0px;
    color: var(--lm_text_strong);
    font-weight: 500;
    text-align: left;
}

.wc-editor-section:checked,
.wc-editor-section:hover {
    background: transparent;
    color: var(--lm_text_strong);
}

#wcKeyColorSwatch {
    border: 1px solid var(--lm_line_strong);
    border-radius: 4px;
    padding: 0px;
}

/* ------------------------------------------------------------------ */
/* Cut / Smooth / Go strip under the monitors                           */

#wirecastTransitionBar {
    background: var(--lm_panel);
}

.wc-transition-slot {
    background: var(--lm_control);
    border: 1px solid transparent;
    border-radius: 7px;
    color: var(--lm_text_soft);
    font-weight: 500;
    padding: 0px 24px 0px 12px;
    margin: 0px;
}

.wc-transition-slot:hover {
    background: var(--lm_control_hover);
}

.wc-transition-slot::menu-button {
    border: none;
    width: 22px;
}

.wc-transition-slot::menu-arrow {
    image: url(theme:Wirecast/caret-down.svg);
    width: 10px;
    height: 10px;
}

.wc-transition-slot.wc-slot-active {
    background: var(--lm_selected);
    border-color: #6B6964;
    color: var(--lm_text_strong);
}

#wirecastGoButton {
    background: var(--lm_ivory);
    border: none;
    border-radius: 7px;
    color: var(--lm_on_ivory);
    font-weight: 600;
    padding: 0px 10px;
    margin: 0px;
}

#wirecastGoButton:hover {
    background: var(--lm_ivory_hover);
}

#wirecastGoButton:pressed {
    background: var(--lm_ivory_down);
}

/* Off in Live-only layout and while Auto live is on */
#wirecastGoButton:disabled {
    background: var(--lm_control);
    color: var(--lm_text_faint);
}

#wirecastAutoLive {
    color: var(--lm_text_soft);
    font-size: var(--font_small);
    background: transparent;
}

#wirecastMonitorGrip {
    color: #45474D;
    font-size: 10pt;
    min-width: 14px;
    max-width: 14px;
    background: transparent;
}

#wirecastMonitorGrip:hover,
#wirecastMonitorGrip[dragging="true"] {
    color: var(--lm_text_soft);
}

/* ------------------------------------------------------------------ */
/* Settings window                                                      */

OBSBasicSettings {
    background: var(--lm_panel);
}

OBSBasicSettings #listWidget {
    background: var(--lm_inset);
    border: none;
    border-bottom: 1px solid var(--lm_line_soft);
    border-radius: 0px;
    padding: 4px 8px 0px 8px;
}

OBSBasicSettings #listWidget::item {
    color: var(--lm_text_soft);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    padding: 6px 2px 4px 2px;
    margin: 0px 1px;
}

OBSBasicSettings #listWidget::item:hover {
    background: var(--lm_control);
    color: var(--lm_text);
}

OBSBasicSettings #listWidget::item:selected,
OBSBasicSettings #listWidget::item:selected:hover {
    background: transparent;
    color: var(--lm_text_strong);
    border-bottom: 2px solid var(--lm_ivory);
}

OBSBasicSettings #settingsPages,
OBSBasicSettings QScrollArea,
OBSBasicSettings QScrollArea > QWidget > QWidget {
    background: var(--lm_panel);
}

OBSBasicSettings QGroupBox,
OBSBasicSettings #PropertiesContainer {
    background: var(--lm_inset);
    border: 1px solid var(--lm_line_soft);
    border-radius: 8px;
}

OBSBasicSettings QGroupBox::title {
    color: var(--lm_text_strong);
}

OBSBasicSettings QDialogButtonBox QPushButton {
    min-width: 80px;
}

OBSBasicSettings QDialogButtonBox QPushButton:default {
    background: var(--lm_ivory);
    border-color: var(--lm_ivory);
    color: var(--lm_on_ivory);
}

/* Tabs inside settings pages (e.g. Output > Advanced) */
OBSBasicSettings QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--lm_text_soft);
    padding: 6px 14px;
}

OBSBasicSettings QTabBar::tab:selected {
    background: transparent;
    color: var(--lm_text_strong);
    border-bottom: 2px solid var(--lm_ivory);
}

/* Snapshot button under the Live monitor */
#wirecastSnapshotButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 3px;
    margin: 0px;
}

#wirecastSnapshotButton:hover {
    background: var(--lm_control_hover);
}

#wirecastPreviewMeter,
#wirecastProgramMeter {
    background: transparent;
}

/* Speaker / headphone buttons under the meters */
.wc-meter-button {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 1px;
    margin: 0px;
}

.wc-meter-button:hover {
    background: var(--lm_control_hover);
}

.wc-meter-button:checked {
    background: var(--lm_selected);
}

